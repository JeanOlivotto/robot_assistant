# Copie para .env e preencha. O gateway lê este arquivo da raiz do repo.
# Caminhos relativos partem da raiz do repo.

# Porta do gateway (webapp em /, robô em /device, app em /app)
PORT=8080

# Token que o robô manda em ws://host:8080/device?token=...
# Tem que ser igual ao ROBO_DEVICE_TOKEN em firmware/main/secrets.h
DEVICE_TOKEN=troque-por-um-token-longo

# Senha do webapp (pedida uma vez no celular)
APP_TOKEN=troque-por-uma-senha

# ── Agenda ──────────────────────────────────────────────────────────────
# Leitura e escrita: conta de serviço do Google com a agenda compartilhada com ela
GOOGLE_SA_KEY_FILE=secrets/google-sa.json
GCAL_ID=seu-email@gmail.com
# Só leitura (usado se não houver conta de serviço): "Endereço secreto no formato iCal"
GCAL_ICS_URL=

# Fuso (nome IANA para o servidor, POSIX para o ESP32)
TZ_NAME=America/Sao_Paulo
TZ_POSIX=<-03>3

ALERT_LEAD_MIN=10
CALENDAR_POLL_SEC=120
AGENDA_HORIZON_H=36

# ── Cérebro (APIs compatíveis com OpenAI) ───────────────────────────────
# Principal: Groq (rápido, plano grátis) — chave em console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Reserva quando o principal falha: NVIDIA (build.nvidia.com), em ordem
LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS=google/gemma-4-31b-it,z-ai/glm-5.3

# Transcrição de voz: Whisper da NVIDIA (vazio = usa LLM_FALLBACK_API_KEY)
STT_API_KEY=

ROBOT_NAME=Robô
OWNER_NAME=

# ── Mensagens que o robô manda sozinho ─────────────────────────────────
PROACTIVE=true
MORNING_AT=08:00
EVENING_AT=18:00

# Histórico da conversa e memória do robô
DATA_DIR=data
