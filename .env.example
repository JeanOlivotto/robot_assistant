# Copie para .env e preencha. O gateway lê este arquivo da raiz do repo.
# Caminhos relativos partem da raiz do repo.

# Porta do gateway (webapp em /, robô em /device, app em /app)
PORT=8080

# Token que o robô manda em ws://host:8080/device?token=...
# Tem que ser igual ao ROBO_DEVICE_TOKEN em firmware/main/secrets.h
DEVICE_TOKEN=troque-por-um-token-longo

# Senha do webapp (pedida uma vez no celular)
APP_TOKEN=troque-por-uma-senha

# ── Agenda ──────────────────────────────────────────────────────────────
# Leitura e escrita: conta de serviço do Google com a agenda compartilhada com ela
GOOGLE_SA_KEY_FILE=secrets/google-sa.json
GCAL_ID=seu-email@gmail.com
# Só leitura (usado se não houver conta de serviço): "Endereço secreto no formato iCal"
GCAL_ICS_URL=

# Fuso (nome IANA para o servidor, POSIX para o ESP32)
TZ_NAME=America/Sao_Paulo
TZ_POSIX=<-03>3

ALERT_LEAD_MIN=10
CALENDAR_POLL_SEC=120
AGENDA_HORIZON_H=36

# ── Cérebro (APIs compatíveis com OpenAI) ───────────────────────────────
# Principal: Groq (rápido, plano grátis) — chave em console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Mais modelos no mesmo provedor, antes da reserva (o Groq grátis limita tokens por minuto POR modelo).
LLM_EXTRA_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Reserva quando o principal falha: NVIDIA (build.nvidia.com), em ordem
LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS=google/gemma-4-31b-it,z-ai/glm-5.3
# Visão (fotos do chat). Vazio = usa o provedor e a chave da reserva (NVIDIA).
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODELS=google/gemma-4-31b-it,meta/llama-3.2-11b-vision-instruct
# Separação de vozes das reuniões (container apps/vozes). Em produção o compose já aponta para
# http://vozes:8090; rodando local, suba o container e use http://localhost:8090.
VOZES_URL=

# Transcrição de voz: Whisper da NVIDIA (vazio = usa LLM_FALLBACK_API_KEY)
STT_API_KEY=

ROBOT_NAME=Robô
OWNER_NAME=

# ── Mensagens que o robô manda sozinho ─────────────────────────────────
PROACTIVE=true
MORNING_AT=08:00
EVENING_AT=18:00

# Avisos de uso do Claude (celular + telinha) ao cruzar estes % por janela. Vazio = desliga.
CLAUDE_ALERT_PERCENTS=50,80,95

# Histórico da conversa e memória do robô
DATA_DIR=data

# Notificação push no celular — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://seu-dominio

# Voz das respostas: edge (grátis, sem chave, não oficial), elevenlabs (chave) ou off
TTS_PROVIDER=edge
# Masculinas: pt-BR-AntonioNeural, en-US-AndrewMultilingualNeural, en-US-BrianMultilingualNeural
EDGE_TTS_VOICE=pt-BR-AntonioNeural
EDGE_TTS_RATE=+0%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Spotify (mostra no robô o que está tocando). Crie um app em developer.spotify.com/dashboard.
# Redirect URI a cadastrar no app: https://SEU_DOMINIO/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://srv1966497.hstgr.cloud/api/spotify/callback

# Endereço público do gateway — vira o link que o robô usa para baixar o firmware (OTA).
PUBLIC_URL=https://srv1966497.hstgr.cloud

# O braço (apps/braco) — agente que roda na SUA máquina e executa o que você autorizou.
# Vazio = braço desligado. Use um token longo e diferente dos outros.
BRACO_TOKEN=
